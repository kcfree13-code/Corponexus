# PostgreSQL Database URL (Local port 5434 configured to avoid conflicts with other local dbs)
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5434/corponexus

# Railway production will automatically inject DATABASE_URL

# Terms & Conditions Version
TERMS_VERSION=v1.0-2026-10

# Compliant SEC EDGAR User-Agent (Mandatory for free SEC XBRL API)
SEC_USER_AGENT=CorpNexus CorporateIntelligence/1.0 (compliance@corponexus.org)

# OpenStreetMap Nominatim User-Agent
NOMINATIM_USER_AGENT=CorpNexus Geocoder/1.0 (info@corponexus.org)

# Optional default OpenCorporates API Key (users can also provide their own BYOK in the mobile app)
OPENCORPORATES_DEFAULT_TOKEN=
